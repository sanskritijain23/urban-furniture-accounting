# Root-level shared environment variables.
# Copy to .env and fill in real local values — NEVER commit .env.

# --- Database (used by backend AND database/seed + Alembic) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urban_furniture

# --- Auth ---
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App ---
APP_NAME=Urban Furniture Accounting System
ENV=development
